# Alternative GNU Make workspace makefile autogenerated by Premake

ifndef config
  config=debug
endif

ifndef verbose
  SILENT = @
endif

ifeq ($(config),debug)
  TemplateTest_config = debug

else ifeq ($(config),release)
  TemplateTest_config = release

else
  $(error "invalid configuration $(config)")
endif

PROJECTS := TemplateTest

.PHONY: all clean help $(PROJECTS) 

all: $(PROJECTS)

TemplateTest:
ifneq (,$(TemplateTest_config))
	@echo "==== Building TemplateTest ($(TemplateTest_config)) ===="
	@${MAKE} --no-print-directory -C . -f TemplateTest.make config=$(TemplateTest_config)
endif

clean:
	@${MAKE} --no-print-directory -C . -f TemplateTest.make clean

help:
	@echo "Usage: make [config=name] [target]"
	@echo ""
	@echo "CONFIGURATIONS:"
	@echo "  debug"
	@echo "  release"
	@echo ""
	@echo "TARGETS:"
	@echo "   all (default)"
	@echo "   clean"
	@echo "   TemplateTest"
	@echo ""
	@echo "For more information, see https://github.com/premake/premake-core/wiki"